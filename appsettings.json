{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TaskManagementDbContext": "Server=(localdb)\\MSSQLLocalDB;Database=TaskManagement;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "JWT": {
    "Key": "a-long-random-secret-at-least-32-characters",
    "Issuer": "TaskManagementApi",
    "Audience": "TaskManagementClient",
    "ExpiryMinutes": "3",
    "RefreshTokenExpiryDays": "7"
  }
}
